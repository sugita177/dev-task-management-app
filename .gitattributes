# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly enforce LF for Dockerfiles, shell scripts, and yaml configurations
Dockerfile text eol=lf
*.dockerfile text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binaries
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
